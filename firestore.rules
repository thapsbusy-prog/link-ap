rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── User profiles ───────────────────────────────────────────────────────
    match /users/{uid} {
      // Any signed-in user can read profiles (required for Discover + Search)
      allow read: if request.auth != null;
      // Only the owner can write their own profile document
      allow write: if request.auth != null && request.auth.uid == uid;

      // ── Matches ─────────────────────────────────────────────────────────
      match /matches/{matchId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        // Owner writes their own matches; the other user writes the mirrored doc
        allow write: if request.auth != null &&
          (request.auth.uid == uid || request.auth.uid == matchId);
      }

      // ── Sent requests ───────────────────────────────────────────────────
      match /sent/{sentToUid} {
        // Owner lists their outgoing requests; recipient reads a single doc
        // to check for mutual match or to see a reply
        allow read: if request.auth != null &&
          (request.auth.uid == uid || request.auth.uid == sentToUid);
        // Only the sender can create a new request
        allow create: if request.auth != null && request.auth.uid == uid;
        // Sender OR recipient can update (recipient mirrors a reply back here)
        allow update: if request.auth != null &&
          (request.auth.uid == uid || request.auth.uid == sentToUid);
        // Sender OR recipient can delete (withdraw / accept / decline)
        allow delete: if request.auth != null &&
          (request.auth.uid == uid || request.auth.uid == sentToUid);
      }

      // ── Received requests ────────────────────────────────────────────────
      // Created when someone sends a search-based connection request with a note
      match /received/{senderUid} {
        // Only the owner can read their incoming requests
        allow read: if request.auth != null && request.auth.uid == uid;
        // The sender creates the document (keyed by their own UID)
        allow create: if request.auth != null && request.auth.uid == senderUid;
        // Owner updates when replying; sender can also update (e.g. withdraw note)
        allow update: if request.auth != null &&
          (request.auth.uid == uid || request.auth.uid == senderUid);
        // Owner deletes on accept/decline; sender deletes on withdraw
        allow delete: if request.auth != null &&
          (request.auth.uid == uid || request.auth.uid == senderUid);
      }

      // ── Passed profiles ─────────────────────────────────────────────────
      match /passed/{passedUid} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── Chat messages ────────────────────────────────────────────────────────
    // chatId is always "{uid1}_{uid2}" with UIDs sorted alphabetically
    match /chats/{chatId}/messages/{msgId} {
      allow read, write: if request.auth != null &&
        request.auth.uid in chatId.split('_');
    }

  }
}
