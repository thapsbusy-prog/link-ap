rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    match /users/{uid} {
      allow get: if request.auth != null &&
        (request.auth.uid == uid || resource.data.deactivated != true);
      allow list: if request.auth != null;
      allow create, update: if request.auth != null &&
        request.auth.uid == uid;
      allow delete: if request.auth != null &&
        request.auth.uid == uid;

      match /private/{document} {
        allow read, write: if request.auth != null &&
          request.auth.uid == uid;
      }

      match /sent/{targetId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null &&
          request.auth.uid == uid &&
          request.resource.data.uid == targetId;
        allow delete: if request.auth != null &&
          (request.auth.uid == uid || request.auth.uid == targetId);
      }

      match /received/{senderId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null &&
          request.auth.uid == senderId &&
          request.resource.data.uid == request.auth.uid;
        allow delete: if request.auth != null &&
          (request.auth.uid == uid || request.auth.uid == senderId);
      }

      match /matches/{matchedUid} {
        allow read: if request.auth != null &&
          (request.auth.uid == uid || request.auth.uid == matchedUid);
        allow write: if request.auth != null &&
          (request.auth.uid == uid || request.auth.uid == matchedUid);
        allow delete: if request.auth != null &&
          (request.auth.uid == uid || request.auth.uid == matchedUid);
      }

      match /passed/{passedUid} {
        allow read, write: if request.auth != null &&
          request.auth.uid == uid;
      }

      match /blocked/{blockedUid} {
        allow read, write: if request.auth != null &&
          request.auth.uid == uid;
      }

      match /blockedBy/{blockerId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if request.auth != null &&
          (request.auth.uid == uid || request.auth.uid == blockerId);
      }
    }

    // Server-side Admin SDK writes bypass these rules; this blocks all client access
    match /matchExplanations/{docId} {
      allow read: if false;
      allow write: if false;
    }

    match /chats/{chatId} {
      allow read, write: if false;

      match /messages/{msgId} {
        function participants() {
          return chatId.split('_');
        }
        function isParticipant() {
          return request.auth.uid == participants()[0] || request.auth.uid == participants()[1];
        }
        function notBlocked() {
          let uid1 = participants()[0];
          let uid2 = participants()[1];
          return !exists(/databases/$(database)/documents/users/$(uid1)/blocked/$(uid2))
            && !exists(/databases/$(database)/documents/users/$(uid2)/blocked/$(uid1));
        }
        allow read: if isAuth() && isParticipant() && notBlocked();
        allow create: if isAuth() && isParticipant() && notBlocked() && request.resource.data.from == request.auth.uid;
      }
    }
  }
}
