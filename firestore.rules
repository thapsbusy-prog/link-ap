rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    match /users/{uid} {
      allow get: if isAuth() && (isOwner(uid) || resource.data.deactivated != true);
      allow list: if isAuth();
      allow create, update: if isAuth() && isOwner(uid);
      allow delete: if isAuth() && isOwner(uid);

      match /matches/{matchedUid} {
        allow read: if isAuth() && (isOwner(uid) || isOwner(matchedUid));
        allow write: if isAuth()
          && (isOwner(uid) || isOwner(matchedUid))
          && request.resource.data.uid == matchedUid;
      }

      match /sent/{targetId} {
        allow read: if isAuth() && (isOwner(uid) || isOwner(targetId));
        allow write: if isAuth() && isOwner(uid);
      }

      match /received/{senderId} {
        allow read: if isAuth() && isOwner(uid);
        allow write: if isAuth()
          && isOwner(senderId)
          && request.resource.data.uid == request.auth.uid;
      }

      match /passed/{passedUid} {
        allow read, write: if isAuth() && isOwner(uid);
      }

      match /blocked/{blockedUid} {
        allow read: if isAuth() && isOwner(uid);
        allow write: if isAuth() && isOwner(uid);
      }

      match /blockedBy/{blockerId} {
        allow read: if isAuth() && isOwner(uid);
        allow write: if isAuth() && (isOwner(uid) || isOwner(blockerId));
      }

      match /private/{doc} {
        allow read, write: if isOwner(uid);
      }
    }

    // Server-side Admin SDK writes bypass these rules; this blocks all client access
    match /matchExplanations/{docId} {
      allow read: if false;
      allow write: if false;
    }

    match /chats/{chatId} {
      allow read, write: if false;

      match /messages/{msgId} {
        function participants() {
          return chatId.split('_');
        }
        function isParticipant() {
          return request.auth.uid == participants()[0] || request.auth.uid == participants()[1];
        }
        function notBlocked() {
          let uid1 = participants()[0];
          let uid2 = participants()[1];
          return !exists(/databases/$(database)/documents/users/$(uid1)/blocked/$(uid2))
            && !exists(/databases/$(database)/documents/users/$(uid2)/blocked/$(uid1));
        }
        allow read: if isAuth() && isParticipant() && notBlocked();
        allow create: if isAuth() && isParticipant() && notBlocked() && request.resource.data.from == request.auth.uid;
      }
    }
  }
}