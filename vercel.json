{
  "crons": [
    { "path": "/api/pulse", "schedule": "0 6 * * *" },
    { "path": "/api/pulse-strategic", "schedule": "0 6 * * *" }
  ],
  "rewrites": [
    { "source": "/user/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "unsafe-none"
        }
      ]
    }
  ]
}
